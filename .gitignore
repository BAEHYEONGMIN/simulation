# =============================================================
# .gitignore — baemin_project
# =============================================================

# --- 민감 정보 (절대 커밋 금지) ---
.env
.env.*
!.env.example

# --- Google Drive 심볼릭 링크 / Junction ---
doro/
doro
drive_images/

# --- Python 캐시 / 빌드 ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
.Python

# --- 가상환경 ---
venv/
.venv/
env/
.env/
ENV/

# --- 패키지 빌드 산출물 ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- PyInstaller ---
*.spec

# --- IDE / 에디터 ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS 자동 생성 파일 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- 로그 / 임시 파일 ---
*.log
*.tmp
*.bak

# --- 실행 파일 / 압축 파일 ---
*.exe
*.dll
*.msi
*.zip
*.tar.gz
*.rar
*.7z

# --- LangChain / AI 모델 캐시 ---
# SentenceTransformer 등 다운로드 모델 캐시
.cache/
sentence-transformers/

# --- langchain_test 진단용 스크립트 (선택적으로 제외) ---
langchain_test/check_models.py

# --- 미디어 / 대용량 파일 ---
# ※ icon.png 같은 필수 소형 리소스는 제외하고 싶다면 아래 주석 해제
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.mp4
# *.wav
# *.mp3
